{
  "name": "dsh-superagent-trace",
  "version": "0.1.1",
  "description": "Trace explorer for dsh-superagent: one task, from first event to last reply.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "coverage": "node scripts/coverage.ts",
    "build": "tsdown"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.0 <0.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckyxiang6688/dsh-superagent-trace.git"
  },
  "homepage": "https://github.com/luckyxiang6688/dsh-superagent-trace",
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/images/source-page.png",
    "docs/images/ticket-timeline.png",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}